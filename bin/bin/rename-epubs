#!/usr/bin/env python3

import argparse
import os
import re
import sys
import zipfile
from pathlib import Path
from xml.etree import ElementTree as ET

NS_CONTAINER = {"c": "urn:oasis:names:tc:opendocument:xmlns:container"}

def clean_filename_part(s: str) -> str:
    s = s.strip()
    s = re.sub(r"\s+", " ", s)
    s = s.replace("/", "-")
    s = s.replace("\\", "-")
    s = s.replace("\0", "")
    return s.strip(" .")

def normalize_author(author: str) -> str:
    author = author.strip()

    # Convert simple "Last, First" -> "First Last"
    # but avoid aggressively rewriting unusual names.
    if author.count(",") == 1:
        left, right = [x.strip() for x in author.split(",", 1)]
        if left and right:
            author = f"{right} {left}"

    return author

def get_epub_metadata(epub_path: Path):
    with zipfile.ZipFile(epub_path) as zf:
        container = ET.fromstring(zf.read("META-INF/container.xml"))
        rootfile = container.find(".//c:rootfile", NS_CONTAINER)

        if rootfile is None:
            raise ValueError("No OPF rootfile found")

        opf_path = rootfile.attrib["full-path"]
        opf = ET.fromstring(zf.read(opf_path))

        # Namespace-independent matching
        title = None
        authors = []

        for elem in opf.iter():
            tag = elem.tag.split("}")[-1]

            if tag == "title" and title is None and elem.text:
                title = elem.text.strip()

            elif tag == "creator" and elem.text:
                authors.append(elem.text.strip())

        if not title:
            title = epub_path.stem

        if not authors:
            authors = ["Unknown"]

        return title, authors

def main():
    parser = argparse.ArgumentParser(
        description="Rename EPUB files to 'Author - Title.epub'"
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Directory containing EPUB files (default: current directory)",
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Actually rename files. Without this flag, performs a dry run.",
    )
    parser.add_argument(
        "--no-reverse",
        action="store_true",
        help="Do not convert 'Last, First' author names to 'First Last'.",
    )

    args = parser.parse_args()
    directory = Path(args.directory).expanduser().resolve()

    if not directory.is_dir():
        print(f"Not a directory: {directory}", file=sys.stderr)
        sys.exit(1)

    files = sorted(directory.glob("*.epub"))

    if not files:
        print("No EPUB files found.")
        return

    for path in files:
        try:
            title, authors = get_epub_metadata(path)

            if not args.no_reverse:
                authors = [normalize_author(a) for a in authors]

            author_text = " & ".join(authors)

            author_text = clean_filename_part(author_text)
            title = clean_filename_part(title)

            new_name = f"{author_text} - {title}.epub"
            new_path = path.with_name(new_name)

            if path.name == new_name:
                print(f"OK:   {path.name}")
                continue

            if new_path.exists():
                print(f"SKIP: {path.name}")
                print(f"      destination already exists: {new_name}")
                continue

            print(f"{path.name}")
            print(f"  -> {new_name}")

            if args.apply:
                path.rename(new_path)

        except Exception as e:
            print(f"ERROR: {path.name}: {e}", file=sys.stderr)

if __name__ == "__main__":
    main()
